{
  "name": "bakery-store",
  "version": "0.1.0",
  "private": true,
  "description": "Bakery Store Desktop Application",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "format": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "format:fix": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "pretest": "node scripts/switch-better-sqlite3.cjs node",
    "test": "vitest run --dir tests",
    "preseed": "node scripts/switch-better-sqlite3.cjs node",
    "seed": "node scripts/seed.mjs",
    "postseed": "node scripts/switch-better-sqlite3.cjs electron",
    "desktop:dev": "pnpm --filter @bakery/desktop dev",
    "desktop:build": "pnpm --filter @bakery/desktop build",
    "desktop:package": "pnpm --filter @bakery/desktop package",
    "desktop:dist": "pnpm --filter @bakery/desktop dist"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
